meta {
  name: gc-77 Put tags on B4
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/books/{{gc77B4}}/tags
  body: json
  auth: none
}

body:json {
  {"tags":["g77{{runId}}-a","g77{{runId}}-c"]}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the book", function () {
    expect(res.body.tags).to.be.an("array");
  });
}

docs {
  Put tags on B4. Response: 200
}
