meta {
  name: gc-77 Similar books with limit and offset
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/books/{{gc77T}}/similar?limit=2&offset=1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns the second page", function () {
    expect(res.body.books.map(function (b) { return b.book.id; })).to.eql([bru.getVar("gc77B1"), bru.getVar("gc77B4")]);
    expect(res.body.total).to.equal(4);
    expect(res.body.limit).to.equal(2);
    expect(res.body.offset).to.equal(1);
  });
}

docs {
  Similar books with limit and offset. Response: 200
}
