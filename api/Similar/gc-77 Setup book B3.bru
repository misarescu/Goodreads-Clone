meta {
  name: gc-77 Setup book B3
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/books
  body: json
  auth: none
}

body:json {
  {"title":"gc-77 Book B3 {{runId}}","author":"Suite Author","isbn":"978-77b3-{{runId}}"}
}

script:post-response {
  bru.setVar("gc77B3", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the book", function () {
    expect(res.body.id).to.be.a("number");
  });
}

docs {
  Setup book B3. Response: 201
}
