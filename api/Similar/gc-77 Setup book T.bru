meta {
  name: gc-77 Setup book T
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/books
  body: json
  auth: none
}

body:json {
  {"title":"gc-77 Book T {{runId}}","author":"Suite Author","isbn":"978-77t-{{runId}}"}
}

script:post-response {
  bru.setVar("gc77T", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the book", function () {
    expect(res.body.id).to.be.a("number");
  });
}

docs {
  Setup book T. Response: 201
}
