meta {
  name: gc-77 Similar books after removing shared tags from a book
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/api/books/{{gc77T}}/similar
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  const runId = bru.getVar("runId");
  const t = function (n) { return "g77" + runId + "-" + n; };
  test("drops the book that no longer shares a tag", function () {
    expect(res.body.books.map(function (b) { return b.book.id; })).to.eql([bru.getVar("gc77B3"), bru.getVar("gc77B4"), bru.getVar("gc77B2")]);
    expect(res.body.books.map(function (b) { return b.sharedTags; })).to.eql([[t("a"), t("b"), t("c")], [t("a"), t("c")], [t("c")]]);
    expect(res.body.total).to.equal(3);
  });
}

docs {
  Similar books after removing shared tags from a book. Response: 200
}
