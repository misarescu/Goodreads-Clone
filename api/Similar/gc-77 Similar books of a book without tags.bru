meta {
  name: gc-77 Similar books of a book without tags
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/books/{{gc77U}}/similar
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns an empty array, not null", function () {
    expect(res.body.books).to.be.an("array").that.is.empty;
    expect(res.body.total).to.equal(0);
  });
}

docs {
  Similar books of a book without tags. Response: 200
}
