meta {
  name: gc-77 Setup book B1
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/books
  body: json
  auth: none
}

body:json {
  {"title":"gc-77 Book B1 {{runId}}","author":"Suite Author","isbn":"978-77b1-{{runId}}"}
}

script:post-response {
  bru.setVar("gc77B1", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the book", function () {
    expect(res.body.id).to.be.a("number");
  });
}

docs {
  Setup book B1. Response: 201
}
