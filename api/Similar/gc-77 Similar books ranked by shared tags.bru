meta {
  name: gc-77 Similar books ranked by shared tags
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/books/{{gc77T}}/similar
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  const runId = bru.getVar("runId");
  const t = function (n) { return "g77" + runId + "-" + n; };
  test("orders by shared tag count then id, with exact sorted sharedTags", function () {
    expect(res.body.books).to.be.an("array");
    expect(res.body.books.map(function (b) { return b.book.id; })).to.eql([bru.getVar("gc77B3"), bru.getVar("gc77B1"), bru.getVar("gc77B4"), bru.getVar("gc77B2")]);
    expect(res.body.books.map(function (b) { return b.sharedTags; })).to.eql([
      [t("a"), t("b"), t("c")], [t("a"), t("b")], [t("a"), t("c")], [t("c")]
    ]);
    expect(res.body.total).to.equal(4);
    expect(res.body.limit).to.equal(20);
    expect(res.body.offset).to.equal(0);
  });
  test("never lists the book itself", function () {
    res.body.books.forEach(function (b) { expect(b.book.id).to.not.equal(bru.getVar("gc77T")); });
  });
  test("book is the representation GET /api/books/{id} returns", function () {
    expect(res.body.books[0].book).to.eql(bru.getVar("gc77SnapB3"));
    expect(res.body.books[1].book).to.eql(bru.getVar("gc77SnapB1"));
    expect(res.body.books[2].book).to.eql(bru.getVar("gc77SnapB4"));
    expect(res.body.books[3].book).to.eql(bru.getVar("gc77SnapB2"));
  });
}

docs {
  Similar books ranked by shared tags. Response: 200
}
