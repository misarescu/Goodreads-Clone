meta {
  name: gc-77 Setup book U
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/books
  body: json
  auth: none
}

body:json {
  {"title":"gc-77 Book U {{runId}}","author":"Suite Author","isbn":"978-77u-{{runId}}"}
}

script:post-response {
  bru.setVar("gc77U", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the book", function () {
    expect(res.body.id).to.be.a("number");
  });
}

docs {
  Setup book U. Response: 201
}
