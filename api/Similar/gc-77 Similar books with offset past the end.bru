meta {
  name: gc-77 Similar books with offset past the end
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/books/{{gc77T}}/similar?offset=10
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns an empty array and the full total", function () {
    expect(res.body.books).to.be.an("array").that.is.empty;
    expect(res.body.total).to.equal(4);
    expect(res.body.offset).to.equal(10);
  });
}

docs {
  Similar books with offset past the end. Response: 200
}
