meta {
  name: gc-77 Setup book L
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/books
  body: json
  auth: none
}

body:json {
  {"title":"gc-77 Book L {{runId}}","author":"Suite Author","isbn":"978-77l-{{runId}}"}
}

script:post-response {
  bru.setVar("gc77L", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the book", function () {
    expect(res.body.id).to.be.a("number");
  });
}

docs {
  Setup book L. Response: 201
}
