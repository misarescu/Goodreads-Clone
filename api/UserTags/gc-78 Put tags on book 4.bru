meta {
  name: gc-78 Put tags on book 4
  type: http
  seq: 17
}

put {
  url: {{baseUrl}}/api/books/{{gc78Book4}}/tags
  body: json
  auth: none
}

body:json {
  {"tags":["g78{{runId}}-fan","g78{{runId}}-onlyc"]}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the tags", function () {
    expect(res.body.tags).to.be.an("array");
  });
}

docs {
  gc-78 Put tags on book 4. Response: 200
}
