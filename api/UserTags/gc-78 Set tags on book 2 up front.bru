meta {
  name: gc-78 Set tags on book 2 up front
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/api/books/{{gc78Book2}}/tags
  body: json
  auth: none
}

body:json {
  {"tags":["g78{{runId}}-fan","g78{{runId}}-cla","g78{{runId}}-apple"]}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the tags", function () {
    expect(res.body.tags).to.be.an("array");
  });
}

docs {
  gc-78 Set tags on book 2 up front. Response: 200
}
