meta {
  name: gc-78 Tags with limit
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/api/users/{{gc78UserA}}/tags?limit=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  const runId = bru.getVar("runId");
  const t = function (n) { return "g78" + runId + "-" + n; };
  test("lists the tags with their book counts", function () {
    expect(res.body.tags).to.eql([{tag:t("fan"),books:3},{tag:t("apple"),books:2}]);
    expect(res.body.total).to.equal(4);
    expect(res.body.limit).to.equal(2);
    expect(res.body.offset).to.equal(0);
  });
}

docs {
  gc-78 Tags with limit. Response: 200
}
