meta {
  name: gc-78 Tags of a user whose books carry no tags
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/users/{{gc78UserE}}/tags
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  const runId = bru.getVar("runId");
  const t = function (n) { return "g78" + runId + "-" + n; };
  test("lists the tags with their book counts", function () {
    expect(res.body.tags).to.eql([]);
    expect(res.body.total).to.equal(0);
    expect(res.body.limit).to.equal(20);
    expect(res.body.offset).to.equal(0);
  });
}

docs {
  gc-78 Tags of a user whose books carry no tags. Response: 200
}
