meta {
  name: gc-78 Tags after the last carrier loses a tag
  type: http
  seq: 39
}

get {
  url: {{baseUrl}}/api/users/{{gc78UserA}}/tags
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  const runId = bru.getVar("runId");
  const t = function (n) { return "g78" + runId + "-" + n; };
  test("lists the tags with their book counts", function () {
    expect(res.body.tags).to.eql([{tag:t("cla"),books:2},{tag:t("fan"),books:2}]);
    expect(res.body.total).to.equal(2);
    expect(res.body.limit).to.equal(20);
    expect(res.body.offset).to.equal(0);
  });
}

docs {
  gc-78 Tags after the last carrier loses a tag. Response: 200
}
