meta {
  name: gc-78 Put tags on book 2
  type: http
  seq: 36
}

put {
  url: {{baseUrl}}/api/books/{{gc78Book2}}/tags
  body: json
  auth: none
}

body:json {
  {"tags":["g78{{runId}}-fan","g78{{runId}}-cla"]}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the tags", function () {
    expect(res.body.tags).to.be.an("array");
  });
}

docs {
  gc-78 Put tags on book 2. Response: 200
}
