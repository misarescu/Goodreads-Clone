meta {
  name: gc-78 Setup user E
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

body:json {
  {"email":"g78E-{{runId}}@example.com","username":"g78E-{{runId}}","password_hash":"hashed_password_here"}
}

script:post-response {
  bru.setVar("gc78UserE", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the user", function () {
    expect(res.body.id).to.be.a("number");
  });
}

