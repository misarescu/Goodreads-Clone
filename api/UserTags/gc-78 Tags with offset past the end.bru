meta {
  name: gc-78 Tags with offset past the end
  type: http
  seq: 29
}

get {
  url: {{baseUrl}}/api/users/{{gc78UserA}}/tags?offset=10
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  const runId = bru.getVar("runId");
  const t = function (n) { return "g78" + runId + "-" + n; };
  test("lists the tags with their book counts", function () {
    expect(res.body.tags).to.eql([]);
    expect(res.body.total).to.equal(4);
    expect(res.body.limit).to.equal(20);
    expect(res.body.offset).to.equal(10);
  });
}

docs {
  gc-78 Tags with offset past the end. Response: 200
}
