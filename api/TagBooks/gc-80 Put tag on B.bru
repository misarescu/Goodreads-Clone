meta {
  name: gc-80 Put tag on B
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/books/{{gc80B}}/tags
  body: json
  auth: none
}

body:json {
  {"tags":["g80{{runId}}-x"]}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the book", function () {
    expect(res.body.tags).to.be.an("array");
  });
}

docs {
  gc-80 Put tag on B. Response: 200
}
