meta {
  name: gc-80 Setup book C
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/books
  body: json
  auth: none
}

body:json {
  {"title":"gc-80 Gamma {{runId}}","author":"Suite Author","isbn":"978-80c-{{runId}}"}
}

script:post-response {
  bru.setVar("gc80C", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the book", function () {
    expect(res.body.id).to.be.a("number");
  });
}

docs {
  gc-80 Setup book C. Response: 201
}
