meta {
  name: gc-80 Get book B
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/books/{{gc80B}}
  body: none
  auth: none
}

script:post-response {
  bru.setVar("gc80SnapB", res.body);
}

assert {
  res.status: eq 200
}

tests {
  test("saves the book", function () {
    expect(res.body.id).to.equal(bru.getVar("gc80B"));
  });
}

docs {
  gc-80 Get book B. Response: 200
}
