meta {
  name: gc-75 Setup Book A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/books
  body: json
  auth: none
}

body:json {
  {
    "title": "gc-75 Book A {{runId}}",
    "author": "Suite Author",
    "isbn": "978-75a-{{runId}}"
  }
}

script:post-response {
  bru.setVar("gc75BookA", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the book", function () {
    expect(res.body.id).to.be.a("number");
  });
}

docs {
  Creates a book the gc-75 requests tag. Deleted before the folder ends.
}
