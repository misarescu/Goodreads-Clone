meta {
  name: gc-75 List tags with offset past the end
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/tags?prefix=g75{{runId}}&offset=10
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("lists the expected page", function () {
    const runId = bru.getVar("runId");
    const expected = [].map(function (r) {
      return { tag: r.tag.replace("@RUN@", runId), books: r.books };
    });
    expect(res.body.tags).to.be.an("array");
    expect(res.body.tags).to.eql(expected);
    expect(res.body.total).to.equal(3);
    expect(res.body.limit).to.equal(20);
    expect(res.body.offset).to.equal(10);
  });
}

docs {
  Lists the tags in use with how many books carry each, narrowed to this run's tags by prefix. Response: 200 OK
}
