meta {
  name: Remove Book from Shelf
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}/api/shelves/{{shelf2Id}}/books/{{bookId}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  Removes a book from a shelf.

  Response: 204 No Content
  400 invalid shelf or book ID, 404 unknown shelf or book not on the shelf
}
