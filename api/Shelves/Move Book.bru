meta {
  name: Move Book
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/shelves/{{shelfId}}/books/{{bookId}}/move
  body: json
  auth: none
}

body:json {
  {
    "to_shelf_id": {{shelf2Id}}
  }
}

assert {
  res.status: eq 200
}

tests {
  test("returns the book on the target shelf with its progress", function () {
    expect(res.body.shelf_id).to.equal(bru.getVar("shelf2Id"));
    expect(res.body.book_id).to.equal(bru.getVar("bookId"));
    expect(res.body.pages_read).to.equal(120);
    expect(res.body.progress_percent).to.equal(40);
  });
}

docs {
  Moves a book from shelf {id} to another shelf of the same user, keeping
  pages_read, progress_percent and finished_at.

  Response: 200 OK with the book's entry on the target shelf, in the form
  GET /api/shelves/{id}/books returns.

  400 invalid IDs or body, target is the same shelf, or the shelves belong
  to different users,
  404 either shelf does not exist or the book is not on shelf {id},
  409 the book is already on the target shelf (nothing changes)
}
