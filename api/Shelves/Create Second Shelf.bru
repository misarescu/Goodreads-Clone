meta {
  name: Create Second Shelf
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/shelves
  body: json
  auth: none
}

body:json {
  {
    "user_id": {{userId}},
    "name": "Second Shelf {{runId}}"
  }
}

script:post-response {
  bru.setVar("shelf2Id", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("echoes what it sent and returns an id", function () {
    const runId = bru.getVar("runId");

    expect(res.body.id).to.be.a("number").and.not.equal(bru.getVar("shelfId"));
    expect(res.body.user_id).to.equal(bru.getVar("userId"));
    expect(res.body.name).to.equal("Second Shelf " + runId);
  });
}

docs {
  Creates a second custom shelf, the target of Move Book.
}
