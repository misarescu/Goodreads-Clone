meta {
  name: Get Shelf by ID
  type: http
  seq: 2
}

get {
  url: http://localhost:8080/api/shelves/1
  body: none
  auth: none
}

docs {
  Retrieves a shelf by its ID.

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "user_id": 1,
      "name": "To Read",
      "is_default": true,
      "created_at": "2024-01-01T00:00:00Z"
    }
  }
  ```

  Response: 404 Not Found
  ```json
  {
    "error": "resource not found"
  }
  ```
}
