meta {
  name: List Shelf Books After Remove
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/shelves/{{shelf2Id}}/books
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("the shelf is empty", function () {
    expect(res.body).to.be.an("array").with.lengthOf(0);
  });
}

docs {
  After Remove Book from Shelf the shelf holds no books.

  Response: 200 OK, []
}
