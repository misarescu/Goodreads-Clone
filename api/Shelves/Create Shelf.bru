meta {
  name: Create Shelf
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/shelves
  body: json
  auth: none
}

body:json {
  {
    "user_id": {{userId}},
    "name": "My Custom Shelf {{runId}}"
  }
}

script:post-response {
  bru.setVar("shelfId", res.body.id);
  bru.setVar("shelfName", res.body.name);
}

assert {
  res.status: eq 201
}

docs {
  Creates a new custom shelf for a user.

  Required fields:
  - user_id (integer)
  - name (string)

  Response: 201 Created
  ```json
  {
    "data": {
      "id": 1,
      "user_id": {{userId}},
      "name": "My Custom Shelf {{runId}}",
      "is_default": false,
      "created_at": "2024-01-01T00:00:00Z"
    }
  }
  ```
}
