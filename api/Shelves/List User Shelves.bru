meta {
  name: List User Shelves
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/api/users/1/shelves
  body: none
  auth: none
}

docs {
  Retrieves all shelves for a specific user.

  Response: 200 OK
  ```json
