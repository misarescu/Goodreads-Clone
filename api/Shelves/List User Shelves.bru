meta {
  name: List User Shelves
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/users/{{userId}}/shelves
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("lists the user's shelves, including the created ones", function () {
    expect(res.body).to.be.an("array");
    const ids = res.body.map((s) => s.id);
    expect(ids).to.include(bru.getVar("shelfId"));
    expect(ids).to.include(bru.getVar("shelf2Id"));
    res.body.forEach((s) => expect(s.user_id).to.equal(bru.getVar("userId")));
  });
}

docs {
  Retrieves all shelves for a specific user.

  Response: 200 OK
  ```json
  {
    "data": [
      {
        "id": 1,
        "user_id": 1,
        "name": "To Read",
        "is_default": true,
        "created_at": "2024-01-01T00:00:00Z"
      },
      {
        "id": 2,
        "user_id": 1,
        "name": "Currently Reading",
        "is_default": true,
        "created_at": "2024-01-01T00:00:00Z"
      },
      {
        "id": 3,
        "user_id": 1,
        "name": "Finished",
        "is_default": true,
        "created_at": "2024-01-01T00:00:00Z"
      },
      {
        "id": 4,
        "user_id": 1,
        "name": "DNF",
        "is_default": true,
        "created_at": "2024-01-01T00:00:00Z"
      }
    ]
  }
  ```
}
