meta {
  name: Export Shelves CSV
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/users/{{userId}}/shelves/export.csv
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("is a CSV with a header and the shelved book", function () {
    const runId = bru.getVar("runId");

    expect(res.getHeader("content-type")).to.contain("text/csv");
    const lines = String(res.body).trim().split("\n");
    expect(lines[0]).to.equal("shelf,title,author,isbn,pages_read,progress_percent,finished_at,added_at");
    expect(lines.length).to.equal(2);
    expect(lines[1]).to.contain("Setup Book " + runId);
  });
}

docs {
  Downloads every book on the user's shelves as CSV, ordered by shelf name then book title.

  Response: 200 OK
  Content-Type: text/csv; charset=utf-8
  Content-Disposition: attachment; filename="shelves-1.csv"
  ```csv
  shelf,title,author,isbn,pages_read,progress_percent,finished_at,added_at
  Finished,"Dune, Part ""One""",Frank Herbert,,412,100,2024-03-01T10:00:00Z,2024-01-01T00:00:00Z
  ```

  A user with no shelved books gets the header row only. 404 for an unknown user.
}
