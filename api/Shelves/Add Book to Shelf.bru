meta {
  name: Add Book to Shelf
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/shelves/{{shelfId}}/books
  body: json
  auth: none
}

body:json {
  {
    "book_id": {{bookId}}
  }
}

assert {
  res.status: eq 201
}

tests {
  test("returns the shelf book with no progress", function () {
    expect(res.body.id).to.be.a("number");
    expect(res.body.shelf_id).to.equal(bru.getVar("shelfId"));
    expect(res.body.book_id).to.equal(bru.getVar("bookId"));
    expect(res.body.pages_read).to.equal(0);
    expect(res.body.progress_percent).to.equal(0);
  });
}

docs {
  Adds a book to a shelf. Pages read and progress start at 0.

  Required fields:
  - book_id (integer)

  Response: 201 Created with the shelf book
  400 invalid shelf ID or body, 404 unknown shelf or book,
  409 book is already on the shelf
}
