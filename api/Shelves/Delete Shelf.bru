meta {
  name: Delete Shelf
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/api/shelves/{{shelfId}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  Deletes a custom shelf.

  Note: Cannot delete default shelves (To Read, Currently Reading, Finished, DNF).

  Response: 204 No Content
}
