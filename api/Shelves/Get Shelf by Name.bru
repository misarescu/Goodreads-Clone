meta {
  name: Get Shelf by Name
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/users/{{userId}}/shelves?name={{shelfName}}
  body: none
  auth: none
}

params:query {
  name: {{shelfName}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the shelf", function () {
    const runId = bru.getVar("runId");

    expect(res.body.id).to.equal(bru.getVar("shelfId"));
    expect(res.body.user_id).to.equal(bru.getVar("userId"));
    expect(res.body.name).to.equal("My Custom Shelf " + runId);
    expect(res.body.is_default).to.equal(false);
  });
}

docs {
  Retrieves a specific shelf for a user by name.

  Query Parameters:
  - name (required): Shelf name

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "user_id": 1,
      "name": "To Read",
      "is_default": true,
      "created_at": "2024-01-01T00:00:00Z"
    }
  }
  ```
}
