meta {
  name: List Shelf Books
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/shelves/{{shelfId}}/books
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("lists the added book", function () {
    expect(res.body).to.be.an("array").with.lengthOf(1);
    expect(res.body[0].book_id).to.equal(bru.getVar("bookId"));
    expect(res.body[0].shelf_id).to.equal(bru.getVar("shelfId"));
    expect(res.body[0]).to.include.keys("pages_read", "progress_percent", "finished_at", "title", "author");
  });
}

docs {
  Lists the books on a shelf with their reading progress
  (pages_read, progress_percent, finished_at) and book details.
  finished_at is an RFC3339 timestamp string, or null if not finished.

  Response: 200 OK, a JSON array
  400 invalid shelf ID, 404 unknown shelf
}
