meta {
  name: List User Reviews
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/users/{{userId}}/reviews?limit=20&offset=0
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("lists the review with the book's title", function () {
    const runId = bru.getVar("runId");

    expect(res.body).to.be.an("array").with.lengthOf(1);
    expect(res.body[0].book_id).to.equal(bru.getVar("bookId"));
    expect(res.body[0].book_title).to.equal("Setup Book " + runId);
  });
}

docs {
  Lists the reviews a user wrote, newest first, each with the reviewed book's title.
  Response: 200 [{"id", "book_id", "book_title", "user_id", "rating", "body", "created_at", "updated_at"}]
  404 unknown user.
}
