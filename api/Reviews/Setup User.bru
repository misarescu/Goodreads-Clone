meta {
  name: Setup User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

body:json {
  {
    "email": "user-{{runId}}@example.com",
    "username": "user-{{runId}}",
    "password_hash": "hashed_password_here"
  }
}

script:post-response {
  bru.setVar("userId", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the user", function () {
    const runId = bru.getVar("runId");

    expect(res.body.id).to.be.a("number");
    expect(res.body.email).to.equal("user-" + runId + "@example.com");
  });
}

docs {
  Creates the user this folder works on. Teardown User deletes it at the end.
}
