meta {
  name: List Reviews
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/books/{{bookId}}/reviews?limit=20&offset=0&sort=recent&min_rating=3
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("lists the review with the reviewer's username", function () {
    const runId = bru.getVar("runId");

    expect(res.body).to.be.an("array").with.lengthOf(1);
    expect(res.body[0].user_id).to.equal(bru.getVar("userId"));
    expect(res.body[0].username).to.equal("user-" + runId);
    expect(res.body[0].rating).to.equal(4);
  });
}

docs {
  Lists a book's reviews, each with the reviewer's username.
  Query: limit, offset (pagination); sort=recent (default, newest first) | rating (highest rating first, newest first among equals); min_rating=1..5 (only reviews rated at least that).
  400 for an unknown sort or a min_rating that is not an integer from 1 to 5.
  Response: 200 [{"id", "book_id", "user_id", "username", "rating", "body", "created_at", "updated_at"}]
  404 unknown book.
}
