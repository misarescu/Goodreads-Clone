meta {
  name: Delete Review
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/books/{{bookId}}/reviews/{{userId}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  Removes a user's review of a book (path is /api/books/{id}/reviews/{userID}).
  Response: 204; 404 when the review does not exist.
}
