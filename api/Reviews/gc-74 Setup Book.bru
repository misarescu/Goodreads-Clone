meta {
  name: gc-74 Setup Book
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/books
  body: json
  auth: none
}

body:json {
  {
    "title": "gc-74 Book {{runId}}",
    "author": "Suite Author",
    "page_count": 100,
    "isbn": "978-74-{{runId}}"
  }
}

script:post-response {
  bru.setVar("gc74BookId", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("creates the book", function () {
    expect(res.body.id).to.be.a("number");
  });
}

docs {
  Creates the book the gc-74 requests rate. Teardown deletes it.
}
