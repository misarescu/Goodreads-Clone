meta {
  name: Replace Review
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/books/{{bookId}}/reviews
  body: json
  auth: none
}

body:json {
  {
    "user_id": {{userId}},
    "rating": 4,
    "body": "Liked it."
  }
}

assert {
  res.status: eq 200
}

tests {
  test("returns the replaced review", function () {
    expect(res.body.id).to.equal(bru.getVar("reviewId"));
    expect(res.body.rating).to.equal(4);
    expect(res.body.body).to.equal("Liked it.");
  });
}

docs {
  Saving again replaces the user's review.

  Response: 200 OK with the review
}
