meta {
  name: Save Review
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/books/{{bookId}}/reviews
  body: json
  auth: none
}

body:json {
  {
    "user_id": {{userId}},
    "rating": 5,
    "body": "Loved it."
  }
}

script:post-response {
  bru.setVar("reviewId", res.body.id);
}

assert {
  res.status: eq 201
}

tests {
  test("returns the review", function () {
    expect(res.body.id).to.be.a("number");
    expect(res.body.book_id).to.equal(bru.getVar("bookId"));
    expect(res.body.user_id).to.equal(bru.getVar("userId"));
    expect(res.body.rating).to.equal(5);
    expect(res.body.body).to.equal("Loved it.");
  });
}

docs {
  Creates the user's review of the book, or replaces it if they already
  reviewed it. Rating 1-5, body 1-5000 characters.
  Response: 201 with the review when created, 200 when replaced.
  400 invalid rating or body, 404 unknown book or user.
}
