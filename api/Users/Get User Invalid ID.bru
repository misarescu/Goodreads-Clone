meta {
  name: Get User With Invalid ID
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/users/abc
  body: none
  auth: none
}

assert {
  res.status: eq 400
}

tests {
  test("body has an error message", function () {
    expect(res.body.Error).to.be.a("string").and.not.empty;
  });
}

docs {
  A user ID that is not a number is rejected.

  Response: 400 Bad Request
}
