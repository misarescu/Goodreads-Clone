meta {
  name: Set Reading Challenge
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/users/{{userId}}/challenges/2026
  body: json
  auth: none
}

body:json {
  {
    "goal": 24
  }
}

assert {
  res.status: eq 200
}

docs {
  Creates or updates the user's reading challenge for a year (goal 1-1000).
  Response: 200 {"year": 2026, "goal": 24}
  400 invalid IDs, year or goal, 404 unknown user.

  GET /api/users/{id}/challenges/{year} returns
  {"year", "goal", "finished", "expected_by_now", "ahead_by"}; 404 when the
  user or the challenge does not exist.
}
