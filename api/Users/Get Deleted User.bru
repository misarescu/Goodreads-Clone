meta {
  name: Get Deleted User
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/users/{{userId}}
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

tests {
  test("body has an error message", function () {
    expect(res.body.Error).to.be.a("string").and.not.empty;
  });
}

docs {
  After Delete User the user no longer exists.

  Response: 404 Not Found
}
