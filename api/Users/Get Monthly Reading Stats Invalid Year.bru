meta {
  name: Get Monthly Reading Stats With Invalid Year
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/users/{{userId}}/stats/monthly?year=1
  body: none
  auth: none
}

params:query {
  year: 1
}

assert {
  res.status: eq 400
}

tests {
  test("body has an error message", function () {
    expect(res.body.Error).to.be.a("string").and.not.empty;
  });
}

docs {
  A year outside 1900..next year is rejected.

  Response: 400 Bad Request
}
