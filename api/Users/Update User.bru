meta {
  name: Update User
  type: http
  seq: 6
}

put {
  url: http://localhost:8080/api/users/1
  body: json
  auth: none
}

body:json {
  {
    "email": "newemail@example.com",
    "username": "newusername"
  }
}

docs {
  Updates a user's email and username.

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "email": "newemail@example.com",
      "username": "newusername",
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-01T00:01:00Z"
    }
  }
  ```
}
