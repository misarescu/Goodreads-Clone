meta {
  name: Update User
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: none
}

body:json {
  {
    "email": "new-{{runId}}@example.com",
    "username": "new-{{runId}}"
  }
}

assert {
  res.status: eq 200
}

docs {
  Updates a user's email and username.

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "email": "new-{{runId}}@example.com",
      "username": "new-{{runId}}",
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-01T00:01:00Z"
    }
  }
  ```
}
