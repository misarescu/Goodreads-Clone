meta {
  name: Update User
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: none
}

body:json {
  {
    "email": "new-{{runId}}@example.com",
    "username": "new-{{runId}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("echoes the new email and username", function () {
    const runId = bru.getVar("runId");
    expect(res.body.id).to.equal(bru.getVar("userId"));
    expect(res.body.email).to.equal("new-" + runId + "@example.com");
    expect(res.body.username).to.equal("new-" + runId);
  });
}

docs {
  Updates a user's email and username.

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "email": "new-{{runId}}@example.com",
      "username": "new-{{runId}}",
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-01T00:01:00Z"
    }
  }
  ```
}
