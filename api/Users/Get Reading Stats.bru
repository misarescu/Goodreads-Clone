meta {
  name: Get Reading Stats
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/users/{{userId}}/stats
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns the three counters", function () {
    expect(res.body.books_on_shelves).to.be.a("number");
    expect(res.body.pages_read).to.be.a("number");
    expect(res.body.books_finished).to.be.a("number");
  });
}

docs {
  Retrieves the reading stats for a user by their ID.

  Response: 200 OK
  ```json
  {
    "books_on_shelves": 12,
    "pages_read": 3400,
    "books_finished": 8
  }
  ```

  Response: 400 Bad Request (invalid user ID)
  ```json
  {
    "Error": "invalid user ID"
  }
  ```

  Response: 404 Not Found (unknown user)
  ```json
  {
    "Error": "resource not found"
  }
  ```
}
