meta {
  name: Delete Reading Challenge
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/api/users/{{userId}}/challenges/2026
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  Deletes the user's reading challenge for a year.

  Response: 204 No Content
  400 invalid user ID or year, 404 when the user or the challenge does not exist.
}
