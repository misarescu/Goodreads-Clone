meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

body:json {
  {
    "email": "user-{{runId}}@example.com",
    "username": "user-{{runId}}",
    "password_hash": "hashed_password_here"
  }
}

script:post-response {
  bru.setVar("userId", res.body.id);
  bru.setVar("userEmail", res.body.email);
  bru.setVar("userUsername", res.body.username);
}

assert {
  res.status: eq 201
}

tests {
  test("echoes what it sent and returns an id", function () {
    const runId = bru.getVar("runId");
    expect(res.body.id).to.be.a("number");
    expect(res.body.email).to.equal("user-" + runId + "@example.com");
    expect(res.body.username).to.equal("user-" + runId);
    expect(res.body).to.not.have.property("password_hash");
  });
}

docs {
  Creates a new user account.

  Response: 201 Created
  ```json
  {
    "data": {
      "id": 1,
      "email": "user-{{runId}}@example.com",
      "username": "user-{{runId}}",
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-01T00:00:00Z"
    }
  }
  ```

  Note: password_hash is excluded from response for security.
}
