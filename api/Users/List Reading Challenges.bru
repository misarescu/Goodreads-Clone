meta {
  name: List Reading Challenges
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/users/{{userId}}/challenges
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("lists the challenge that was set", function () {
    expect(res.body).to.be.an("array");
    const c = res.body.find((x) => x.year === 2026);
    expect(c).to.be.an("object");
    expect(c.goal).to.equal(24);
    expect(c).to.include.keys("finished", "expected_by_now", "ahead_by");
  });
}

docs {
  Lists all of the user's reading challenges, newest year first.
  Response: 200 [{"year", "goal", "finished", "expected_by_now", "ahead_by"}]
  (same fields as GET /api/users/{id}/challenges/{year}); [] when the user has
  no challenges. 400 invalid user ID, 404 unknown user.
}
