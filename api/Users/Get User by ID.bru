meta {
  name: Get User by ID
  type: http
  seq: 2
}

get {
  url: http://localhost:8080/api/users/1
  body: none
  auth: none
}

docs {
  Retrieves a user by their ID.

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "email": "user@example.com",
      "username": "johndoe",
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-01T00:00:00Z"
    }
  }
  ```

  Response: 404 Not Found
  ```json
  {
    "error": "resource not found"
  }
  ```
}
