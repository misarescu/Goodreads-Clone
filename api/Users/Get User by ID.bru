meta {
  name: Get User by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/users/{{userId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns the created user", function () {
    expect(res.body.id).to.equal(bru.getVar("userId"));
    expect(res.body.email).to.equal(bru.getVar("userEmail"));
    expect(res.body.username).to.equal(bru.getVar("userUsername"));
  });
}

docs {
  Retrieves a user by their ID.

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "email": "user@example.com",
      "username": "johndoe",
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-01T00:00:00Z"
    }
  }
  ```

  Response: 404 Not Found
  ```json
  {
    "error": "resource not found"
  }
  ```
}
