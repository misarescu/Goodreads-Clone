meta {
  name: Readiness
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/ready
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("reports ready", function () {
    expect(res.body.status).to.equal("ready");
  });
}

docs {
  Readiness probe. Pings the database (unlike /api/health, which does not).

  Response: 200 OK
  ```json
  {"status":"ready"}
  ```

  Response: 503 Service Unavailable (database does not answer)
  ```json
  {"status":"unavailable"}
  ```
}
