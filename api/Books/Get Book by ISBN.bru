meta {
  name: Get Book by ISBN
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/books?isbn=978-0-{{runId}}
  body: none
  auth: none
}

params:query {
  isbn: 978-0-{{runId}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the created book", function () {
    const runId = bru.getVar("runId");

    expect(res.body.id).to.equal(bru.getVar("bookId"));
    expect(res.body.isbn.String).to.equal("978-0-" + runId);
  });
}

docs {
  Retrieves a book by its ISBN.

  Query Parameters:
  - isbn (required): Book's ISBN

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "title": "The Great Gatsby",
      "author": "F. Scott Fitzgerald",
      "page_count": 180,
      "isbn": "978-0-7432-7356-5",
      "release_date": "1925-04-10T00:00:00Z",
      "language": "English",
      "rating": 4.5,
      "created_at": "2024-01-01T00:00:00Z"
    }
  }
  ```
}
