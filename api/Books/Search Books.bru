meta {
  name: Search Books
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/books/search?q=gatsby {{runId}}&limit=20
  body: none
  auth: none
}

params:query {
  q: gatsby {{runId}}
  limit: 20
}

assert {
  res.status: eq 200
}

tests {
  test("returns the pagination envelope with the created book", function () {
    expect(res.body.books).to.be.an("array");
    expect(res.body.total).to.be.a("number").and.at.least(1);
    expect(res.body.limit).to.equal(20);
    expect(res.body.offset).to.equal(0);
    expect(res.body.books.map((b) => b.id)).to.include(bru.getVar("bookId"));
  });
}

docs {
  Searches for books by title.

  Query Parameters:
  - q (required): Search query for book title
  - limit (optional): Number of results to return (default: 20)

  Response: 200 OK
  ```json
  {
    "data": [
      {
        "id": 1,
        "title": "The Great Gatsby",
        "author": "F. Scott Fitzgerald",
        "page_count": 180,
        "isbn": "978-0-7432-7356-5",
        "release_date": "1925-04-10T00:00:00Z",
        "language": "English",
        "rating": 4.5,
        "created_at": "2024-01-01T00:00:00Z"
      }
    ]
  }
  ```
}
