meta {
  name: Search Books
  type: http
  seq: 5
}

get {
  url: http://localhost:8080/api/books/search?q=gatsby&limit=20
  body: none
  auth: none
}

params:query {
  q: gatsby
  limit: 20
}

docs {
  Searches for books by title.

  Query Parameters:
  - q (required): Search query for book title
  - limit (optional): Number of results to return (default: 20)

  Response: 200 OK
  ```json
  {
    "data": [
      {
        "id": 1,
        "title": "The Great Gatsby",
        "author": "F. Scott Fitzgerald",
        "page_count": 180,
        "isbn": "978-0-7432-7356-5",
        "release_date": "1925-04-10T00:00:00Z",
        "language": "English",
        "created_at": "2024-01-01T00:00:00Z"
      }
    ]
  }
  ```
}
