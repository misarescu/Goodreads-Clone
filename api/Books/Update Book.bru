meta {
  name: Update Book
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/books/{{bookId}}
  body: json
  auth: none
}

body:json {
  {
    "title": "The Great Gatsby {{runId}} (Updated)",
    "author": "F. Scott Fitzgerald",
    "page_count": 185,
    "isbn": "978-0-{{runId}}",
    "release_date": "1925-04-10T00:00:00Z",
    "language": "English",
    "cover_url": "https://example.com/covers/gatsby.jpg",
    "rating": 4.5
  }
}

assert {
  res.status: eq 200
}

docs {
  Updates a book's information.

  Required fields:
  - title (string)
  - author (string)

  Optional fields:
  - page_count (integer)
  - isbn (string)
  - release_date (string, RFC3339 format)
  - language (string)
  - cover_url (string, absolute http or https URL, at most 2048 characters; on update, omitted or null clears it)
  - rating (number, 0 to 5 in increments of 0.25; omitted or null means unrated)

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "title": "The Great Gatsby {{runId}} (Updated)",
      "author": "F. Scott Fitzgerald",
      "page_count": 185,
      "isbn": "978-0-{{runId}}",
      "release_date": "1925-04-10T00:00:00Z",
      "language": "English",
      "cover_url": "https://example.com/covers/gatsby.jpg",
      "rating": 4.5,
      "created_at": "2024-01-01T00:00:00Z"
    }
  }
  ```
}
