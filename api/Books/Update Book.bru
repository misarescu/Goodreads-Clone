meta {
  name: Update Book
  type: http
  seq: 6
}

put {
  url: http://localhost:8080/api/books/1
  body: json
  auth: none
}

body:json {
  {
    "title": "The Great Gatsby (Updated)",
    "author": "F. Scott Fitzgerald",
    "page_count": 185,
    "isbn": "978-0-7432-7356-5",
    "release_date": "1925-04-10T00:00:00Z",
    "language": "English"
  }
}

docs {
  Updates a book's information.

  Required fields:
  - title (string)
  - author (string)

  Optional fields:
  - page_count (integer)
  - isbn (string)
  - release_date (string, RFC3339 format)
  - language (string)

  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "title": "The Great Gatsby (Updated)",
      "author": "F. Scott Fitzgerald",
      "page_count": 185,
      "isbn": "978-0-7432-7356-5",
      "release_date": "1925-04-10T00:00:00Z",
      "language": "English",
      "created_at": "2024-01-01T00:00:00Z"
    }
  }
  ```
}
