meta {
  name: List Books by Tag
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/books?tag=sci-fi-{{runId}}&limit=20&offset=0
  body: none
  auth: none
}

params:query {
  tag: sci-fi-{{runId}}
  limit: 20
  offset: 0
}

assert {
  res.status: eq 200
}

tests {
  test("lists only the tagged book", function () {
    const runId = bru.getVar("runId");

    expect(res.body).to.be.an("array").with.lengthOf(1);
    expect(res.body[0].id).to.equal(bru.getVar("bookId"));
    expect(res.body[0].tags).to.include("sci-fi-" + runId);
  });
}

docs {
  Lists only the books carrying the tag (trimmed and lowercased first), newest first.

  Query Parameters:
  - tag: a valid tag (1 to 32 characters from a-z, 0-9 and "-"); invalid is 400
  - limit (optional): default 20, max 100
  - offset (optional): default 0

  Every book in the response has a sorted `tags` array (`[]` when none).
}
