meta {
  name: List Books
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/api/books?limit=20&offset=0
  body: none
  auth: none
}

params:query {
  limit: 20
  offset: 0
}

docs {
  Retrieves a paginated list of books.

  Query Parameters:
  - limit (optional): Number of books to return (default: 20, max: 100)
  - offset (optional): Number of books to skip (default: 0)

  Response: 200 OK
  ```json
  {
    "data": [
      {
        "id": 1,
        "title": "The Great Gatsby",
        "author": "F. Scott Fitzgerald",
        "page_count": 180,
        "isbn": "978-0-7432-7356-5",
        "release_date": "1925-04-10T00:00:00Z",
        "language": "English",
        "created_at": "2024-01-01T00:00:00Z"
      }
    ]
  }
  ```
}
