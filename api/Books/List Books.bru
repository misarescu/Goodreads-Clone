meta {
  name: List Books
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/books?limit=20&offset=0
  body: none
  auth: none
}

params:query {
  limit: 20
  offset: 0
}

assert {
  res.status: eq 200
}

tests {
  test("returns an array of at most limit books", function () {
    expect(res.body).to.be.an("array");
    expect(res.body.length).to.be.at.most(20);
    res.body.forEach((b) => expect(b).to.include.keys("id", "title", "author", "tags"));
  });
}

docs {
  Retrieves a paginated list of books.

  Query Parameters:
  - limit (optional): Number of books to return (default: 20, max: 100)
  - offset (optional): Number of books to skip (default: 0)

  Response: 200 OK
  ```json
  {
    "data": [
      {
        "id": 1,
        "title": "The Great Gatsby",
        "author": "F. Scott Fitzgerald",
        "page_count": 180,
        "isbn": "978-0-7432-7356-5",
        "release_date": "1925-04-10T00:00:00Z",
        "language": "English",
        "rating": 4.5,
        "created_at": "2024-01-01T00:00:00Z"
      }
    ]
  }
  ```
}
