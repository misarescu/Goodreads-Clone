meta {
  name: Get Book by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/books/{{bookId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns the created book", function () {
    const runId = bru.getVar("runId");

    expect(res.body.id).to.equal(bru.getVar("bookId"));
    expect(res.body.title).to.equal("The Great Gatsby " + runId);
    expect(res.body.author).to.equal("F. Scott Fitzgerald");
  });
}

docs {
  Retrieves a book by its ID.
  
  Response: 200 OK
  ```json
  {
    "data": {
      "id": 1,
      "title": "The Great Gatsby",
      "author": "F. Scott Fitzgerald",
      "page_count": 180,
      "isbn": "978-0-7432-7356-5",
      "release_date": "1925-04-10T00:00:00Z",
      "language": "English",
      "rating": 4.5,
      "created_at": "2024-01-01T00:00:00Z"
    }
  }
  ```
  
  Response: 404 Not Found
  ```json
  {
    "error": "resource not found"
  }
  ```
}
