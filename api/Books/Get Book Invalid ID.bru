meta {
  name: Get Book With Invalid ID
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/books/abc
  body: none
  auth: none
}

assert {
  res.status: eq 400
}

tests {
  test("body has an error message", function () {
    expect(res.body.Error).to.be.a("string").and.not.empty;
  });
}

docs {
  Response: 400 Bad Request (invalid book ID)
}
